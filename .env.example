# Model: pick one provider. Real keys go here locally only; never in screenshots, chat or Git.
# Classroom default: OpenRouter (openai-compatible). Only fill MODEL_API_KEY below.
# To use Claude directly instead: set MODEL_PROVIDER=anthropic and fill ANTHROPIC_API_KEY.
MODEL_PROVIDER=openai-compatible

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_VERSION=2026-10-21
# Required for Claude keys that are not scoped to one workspace.
ANTHROPIC_WORKSPACE_ID=

# OpenRouter (MODEL_PROVIDER=openai-compatible). The model must support tools.
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_ID=anthropic/claude-sonnet-5.5
MODEL_API_KEY=

# LINE (optional). Set LINE_ENABLED=1 only after filling both values.
LINE_ENABLED=0
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

